rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'kauangabrielsilva777@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Private Data Isolation - Only the authenticated owner can access and mutate their own data
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow write: if isOwner(userId);

      match /userData/{docId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(docId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }
    }

    // Whitelist Access Configuration
    // Authenticated users can read the whitelist to verify access permission; only the admin can modify it.
    match /whitelist/{configId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin() && isValidId(configId);
    }
  }
}
